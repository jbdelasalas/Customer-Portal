# ---- Database (new Supabase project — NOT the ERP database) ----
# Transaction-mode pooler (port 6543) is correct for serverless.
POSTGRES_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct connection, used by migrations.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=30d

# ---- App ----
NEXT_PUBLIC_APP_NAME=Art Fresh
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- File uploads (onboarding documents) ----
# 'local' writes to ./uploads (dev only); 'supabase' uses Supabase Storage.
UPLOAD_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=onboarding-docs

# ---- Email (Resend) ----
# Without RESEND_API_KEY the mail driver is 'log': messages are printed to the
# server log instead of sent, so development never emails real people.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or sending is refused.
MAIL_FROM=Art Fresh <no-reply@send.artfreshchicken.ph>
